# Copy to .env.vps, edit privately, and protect it with chmod 600.
# PUBLIC_HOST must be an owned DNS name pointing to the VPS.
PUBLIC_HOST=amamihe.example.net
ACME_EMAIL=owner@example.net

# Generate each password independently with: openssl rand -hex 32
# Use 64 hexadecimal characters so the application connection URL is valid.
POSTGRES_ADMIN_PASSWORD=replace_with_64_hex_characters
POSTGRES_APP_PASSWORD=replace_with_a_different_64_hex_password
