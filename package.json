{
  "name": "amamihe",
  "version": "1.0.0",
  "description": "Browser-based 3D learning world with visual course authoring",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "format": "prettier --write src server shared tests scripts *.json *.ts",
    "format:check": "prettier --check src server shared tests scripts *.json *.ts",
    "audit:browser": "node scripts/browser/browser-audit.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nolwac/amamihe.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Nolwac/amamihe/issues"
  },
  "homepage": "https://github.com/Nolwac/amamihe#readme",
  "dependencies": {
    "@babylonjs/core": "^9.30.0",
    "@babylonjs/loaders": "^9.30.0",
    "@electric-sql/pglite": "^0.5.8",
    "@fastify/compress": "^9.2.1",
    "@fastify/cookie": "^11.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.5",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "fastify": "^5.12.5",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ts-fsrs": "^5.4.2",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "private": true
}
