# Public template only. Store the actual file outside the checkout and releases.
# Protect the actual file and shared directory with modes 0600 and 0700.
AMAMIHE_SHARED_DIR=/srv/amamihe/shared

# No default: select a free TCP port after checking the existing VPS services.
APP_LOOPBACK_PORT=replace_with_unused_port

# Pin the official PostgreSQL 17 bookworm manifest digest after inventory.
POSTGRES_IMAGE=postgres:17-bookworm@sha256:replace_with_approved_digest

# Generate each independently with openssl rand -hex 32; never commit values.
POSTGRES_ADMIN_PASSWORD=replace_with_64_hex_characters
POSTGRES_APP_PASSWORD=replace_with_a_different_64_hex_password

# Optional private moderator identifiers and policy thresholds. Omit unset keys.
# SOCIAL_MODERATOR_IDS=verified_player_id
# WORLD_IDLE_WARNING_SECONDS=600
# WORLD_IDLE_ARREST_SECONDS=900
# Classification remains mock with zero budget unless explicitly configured privately.
# DECISION_PROVIDER=mock
# OPENROUTER_API_KEY=private_value_outside_git
# OPENROUTER_MAX_REQUEST_COST_USD=0
