# Optional external PostgreSQL. Leave unset for persistent local PGlite in .data/.
# Configure the real URL as a secret on the host; never put it in VITE_* variables.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/amamihe?sslmode=verify-full

# Optional PEM CA certificate for a provider with a private certificate authority.
# Publicly trusted providers such as Neon do not need this setting.
# DATABASE_CA_CERT=

# Local PGlite directory (ignored when DATABASE_URL is set).
# DATA_DIR=.data
# PORT=3000
# NODE_ENV=production requires DATABASE_URL and HTTPS.
