# Optional external PostgreSQL. Leave unset for persistent local PGlite in .data/.
# Configure the real URL as a secret on the host; never put it in VITE_* variables.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/amamihe?sslmode=verify-full

# Optional PEM CA certificate for a provider with a private certificate authority.
# Publicly trusted providers such as Neon do not need this setting.
# DATABASE_CA_CERT=

# Local PGlite directory (ignored when DATABASE_URL is set).
# DATA_DIR=.data
# PORT=3000
# NODE_ENV=production requires DATABASE_URL and HTTPS.

# Production: mount a mode-0600 JSON file outside Git with provider, apiKey,
# inbox and a generated codeSecret. No VITE_* secrets or test provider in production.
# EMAIL_CONFIG_FILE=/run/amamihe/email.json
# Local automated testing only (codes written privately, never returned over HTTP):
# EMAIL_PROVIDER=test
# EMAIL_TEST_OUTBOX=.data/test-outbox

# Optional world operations; configure privately, never in VITE_* variables.
# SOCIAL_MODERATOR_IDS=verified_player_id
# WORLD_IDLE_WARNING_SECONDS=600
# WORLD_IDLE_ARREST_SECONDS=900
# DECISION_PROVIDER=mock
# OPENROUTER_API_KEY=private_value_outside_git
# OPENROUTER_MAX_REQUEST_COST_USD=0
